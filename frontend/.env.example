#   cp frontend/.env.example frontend/.env

# URL of the backend API (no trailing slash)
VITE_API_URL=http://localhost:3001/api

# ─── Production ───────────────────────────────────────────────────────────────
# Uncomment when deploying:
# VITE_API_URL=https://your-backend.onrender.com/api
