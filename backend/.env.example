# ─── Local Development ───────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

PORT=3001
NODE_ENV=development

# PostgreSQL connection string for local development
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/taskflow

# Optional: separate database used only when running `npm test`
# If omitted, tests will use DATABASE_URL (not recommended — tests wipe the DB)
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/taskflow_test

# ─── Production (Supabase example) ───────────────────────────────────────────
# Uncomment and fill in when deploying:
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# FRONTEND_URL=https://your-frontend.vercel.app
# NODE_ENV=production
