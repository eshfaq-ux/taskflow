# Production — Required for PostgreSQL (use Supabase pooler for better reliability)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Optional — Use a separate database for running tests
TEST_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Application
PORT=3001
NODE_ENV=production

# Frontend URL for CORS (production only)
FRONTEND_URL=https://your-frontend.vercel.app
